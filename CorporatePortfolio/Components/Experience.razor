@using System.Text.RegularExpressions
@using CorporatePortfolio.Services
@using CorporatePortfolio.Services.DTO
@implements IDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AppState State
@inject IJSRuntime JS

<div class="section" id="experience">
    <h2>Experience Highlights</h2>

    @if (!_isLoaded)
    {
        <p>Loading...</p>
    }
    else
    {
        <div class="timeline">
            @foreach (var experience in State.Experiences)
            {
                var idx = State.Experiences.IndexOf(experience);
                <div id="@($"exp-{idx}")"
                     class="timeline-item @(State.Experiences.IndexOf(experience) == 0 ? "fade-in" : "fade-up")"
                     style="transition-delay: 0.2s;">
                    <div class="timeline-dot">@experience.Date</div>

                    <div class="customcard @(experience.HasKeyword ? "glowing-container" : "")">
                        <h3><i class="bi bi-briefcase"></i> @experience.Title - @experience.CompanyName</h3>
                        @foreach (var detail in experience.DetailsFormatted)
                        {
                            <p>@detail</p>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _isLoaded = false;
    private string? _pendingScrollElementId;

    protected override async Task OnInitializedAsync()
    {
        State.ExperiencesOnChange += HandleStateChange;
        State.OnSkillSelected += PrepareScroll;

        _isLoaded = true;
    }

    private async void PrepareScroll(string skillName)
    {
        string escapedSkill = Regex.Escape(skillName);
        string startBoundary = Regex.IsMatch(skillName, @"^[a-zA-Z0-9]") ? @"\b" : @"(?<![a-zA-Z0-9])";
        string endBoundary = Regex.IsMatch(skillName, @"[a-zA-Z0-9]$") ? @"\b" : @"(?![a-zA-Z0-9])";

        string pattern = startBoundary + escapedSkill + endBoundary;
        var options = RegexOptions.IgnoreCase;

        var expTarget = State.Experiences.FirstOrDefault(e =>
            e.Details.Any(d => Regex.IsMatch(d, pattern, options)));

        if (expTarget != null)
        {
            int indexExp = State.Experiences.IndexOf(expTarget);

            await InvokeAsync(() =>
            {
                _pendingScrollElementId = $"exp-{indexExp}";
                StateHasChanged();
            });
        }
        else
        {
            var projTarget = State.Projects.FirstOrDefault(e =>
                e.Details.Any(d => Regex.IsMatch(d, pattern, options)));

            if (projTarget != null)
            {
                int indexProj = State.Projects.IndexOf(projTarget);

                await InvokeAsync(() =>
                {
                    _pendingScrollElementId = $"proj-{indexProj}";
                    StateHasChanged();
                });
            }
        }
    }

    private void HandleStateChange()
    {
        _isLoaded = true;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.ExperiencesOnChange -= HandleStateChange;
        State.OnSkillSelected -= PrepareScroll;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initScrollAnimations");
        }

        if (!string.IsNullOrEmpty(_pendingScrollElementId))
        {
            var id = _pendingScrollElementId;
            _pendingScrollElementId = null; 
            await JS.InvokeVoidAsync("scrollToElement", id);
        }
    }
}