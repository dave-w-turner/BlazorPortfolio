@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IJSRuntime JSRuntime
@inject AppState State
@inject ResumeService ResumeService
@implements IDisposable
@using CorporatePortfolio.Services

@if (State.AreSkillsLoaded)
{
    <div class="main-app-layout">
        <Header />
        <Skills />
        <Experience />
        <Projects />
        <LetsConnect />
        <Footer />
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        State.SkillsLoaded += HandleStateChanged;
        State.ExperiencesOnChange += HandleStateChanged;

        if (!State.AreExperiencesLoaded)
        {
            try
            {
                State.Experiences = await resumeService.GetExperience();

                foreach (var exp in State.Experiences)
                    foreach (var detail in exp.Details)
                        exp.DetailsFormatted.Add(new MarkupString(detail));
            }
            finally
            {
                State.UpdateExperiencesLoadingState(true);
            }
        }

        try
        {
            State.Competencies = await ResumeService.GetCompetencies(State.Experiences, await resumeService.GetProjects());
        }
        finally
        {
            State.UpdateSkillsLoadingState(true);
        }
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && State.AreSkillsLoaded)
        {
            await JSRuntime.InvokeVoidAsync("initScrollAnimations");
        }
    }

    public void Dispose()
    {
        State.SkillsLoaded -= HandleStateChanged;
        State.ExperiencesOnChange -= HandleStateChanged;
    }
}