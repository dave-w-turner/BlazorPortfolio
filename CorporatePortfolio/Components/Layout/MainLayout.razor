@using CorporatePortfolio.Components
@inherits LayoutComponentBase
@implements IDisposable
@inject AppState State

<MudThemeProvider @rendermode="InteractiveServer" IsDarkMode="true" Theme="_darkTheme" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />
<MudPopoverProvider @rendermode="InteractiveServer" />

@if (State.Loading && !State.ErrorOccured)
{
    <Loading />
}

<MudLayout>
    <MudMainContent>
        @Body
    </MudMainContent>

    <ChatWidget />
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private readonly MudTheme _darkTheme = new()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#6366f1",
            Background = "#020617",
            Surface = "#0f172a"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        State.ErrorInvoked += StateHasChanged;
        await State.InitializeAsync();
    }   

    public void Dispose()
    {
        State.ExperiencesOnChange -= StateHasChanged;
    }
}
