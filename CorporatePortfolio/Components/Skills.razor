@using System.Text.RegularExpressions
@using CorporatePortfolio.Services
@using CorporatePortfolio.Services.DTO
@inject IJSRuntime JS
@inject AppState State
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="section" id="skills">
    <h2>Core Expertise</h2>

    <div class="grid" @onmouseleave="HandleGlobalMouseOut">
        @foreach (var competency in State.Competencies)
        {
            <div class="customcard @(competency.Name == State.ClickedSkillName ? "selected-active" : "")"
                 @onclick="(() => OnSkillClick(competency.Name))" @onmouseover="() => State.SetHoveredSkillSummary(competency.Name)">

                <span class="card-content">
                    <i class="bi bi-@competency.Icon"></i> @competency.Name
                </span>
            </div>
        }
    </div>
</div>

@code {
    private async Task HandleGlobalMouseOut()
    {
        State.MouseDebounceCancellationToken?.Cancel();
        State.MouseDebounceCancellationToken = new System.Threading.CancellationTokenSource();
        var activeToken = State.MouseDebounceCancellationToken.Token;

        try
        {
            await Task.Delay(200, activeToken);

            if (!activeToken.IsCancellationRequested)
            {
                State.ClearHoveredSkillSummary();
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task OnSkillClick(string skillName)
    {
        State.SetClickedSkillSummary(skillName);

        string escapedSkill = Regex.Escape(skillName);
        string startBoundary = Regex.IsMatch(skillName, @"^[a-zA-Z0-9]") ? @"\b" : @"(?<![a-zA-Z0-9])";
        string endBoundary = Regex.IsMatch(skillName, @"[a-zA-Z0-9]$") ? @"\b" : @"(?![a-zA-Z0-9])";
        string pattern = startBoundary + escapedSkill + endBoundary;
        var regex = new Regex(pattern, RegexOptions.IgnoreCase);

        foreach (var exp in State.Experiences)
        {
            exp.HasKeyword = false;

            for (int b = 0; b < exp.Details.Count; b++)
            {
                if (regex.IsMatch(exp.Details[b]))
                {
                    var formattedText = await ChatbotService.FormatMessage(exp.Details[b], true, skillName, true);

                    if (b < exp.DetailsFormatted.Count)
                    {
                        exp.DetailsFormatted[b] = (MarkupString)formattedText.Text;
                    }

                    exp.HasKeyword = true;
                }
                else
                {
                    if (b < exp.DetailsFormatted.Count)
                    {
                        exp.DetailsFormatted[b] = (MarkupString)exp.Details[b];
                    }
                }
            }
        }

        foreach (var proj in State.Projects)
        {
            proj.HasKeyword = false;

            for (int b = 0; b < proj.Details.Count; b++)
            {
                if (regex.IsMatch(proj.Details[b]))
                {
                    var formattedText = await ChatbotService.FormatMessage(proj.Details[b], true, skillName, true);

                    if (b < proj.DetailsFormatted.Count)
                    {
                        proj.DetailsFormatted[b] = (MarkupString)formattedText.Text;
                    }

                    proj.HasKeyword = true;
                }
                else
                {
                    if (b < proj.DetailsFormatted.Count)
                    {
                        proj.DetailsFormatted[b] = (MarkupString)proj.Details[b];
                    }
                }
            }
        }

        State.NotifyStateChanged();
        State.SelectSkill(skillName);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(50);

            try
            {
                await JS.InvokeVoidAsync("initScrollAnimations");
            }
            catch
            {
                
            }
        }
    }
}
