@using CorporatePortfolio.DTO
@using CorporatePortfolio.Services
@using CorporatePortfolio.Services.DTO
@using Microsoft.AspNetCore.Components.WebAssembly.Http
@inject NavigationManager NavigationManager
@inject ChatState State
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@inject IHostEnvironment HostEnvironment
@inject HttpClient Http
@implements IDisposable

<MudDialog Class="chat-dark" Style="@_customStyle" ContentClass="mudDialog">
    <TitleContent>
        <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.SmartToy" Class="mr-3 mb-n1" />
                David Turner
            </MudText>

            @if (HostEnvironment.IsDevelopment())
            {
                <MudToggleIconButton @bind-Toggled="ShowAvatarPanel"
                                     Icon="@Icons.Material.Filled.VideocamOff"
                                     Color="@Color.Default"
                                     ToggledIcon="@Icons.Material.Filled.Videocam"
                                     ToggledColor="@Color.Primary"
                                     ToolTip="@(ShowAvatarPanel ? "Hide AI Face Stream" : "Show AI Face Stream")"
                                     Class="mr-8" />
            }
            else
            {
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <MudToggleIconButton @bind-Toggled="ShowAvatarPanel"
                                             Icon="@Icons.Material.Filled.VideocamOff"
                                             Color="@Color.Default"
                                             ToggledIcon="@Icons.Material.Filled.Videocam"
                                             ToggledColor="@Color.Primary"
                                             ToolTip="@(ShowAvatarPanel ? "Hide AI Face Stream" : "Show AI Face Stream")"
                                             Class="mr-8" />
                    </Authorized>
                </AuthorizeView>
            }
        </div>
    </TitleContent>
    <DialogContent>
        <div style="display: flex; width: 100%; height: 100%; min-height: 450px;">
            <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden; border-right: 1px solid rgba(255,255,255,0.05);">
                <div id="chat-container" style="flex-grow: 1; overflow-y: auto;" class="pa-4">
                    @foreach (var msg in _messages)
                    {
                        @if (msg.IsConnecting)
                        {
                            <div class="connecting-status-bar @(_isExiting ? "fade-out-down" : "fade-in-down")">
                                <div class="connecting-dot-glow"></div>
                                <span class="connecting-text">Connecting with David Turner...</span>
                                <div class="scanner-sweep"></div>
                            </div>
                        }
                        else
                        {
                            <div style="display: flex; flex-direction: @(msg.IsUser ? "row-reverse" : "row");" class="mb-6 gap-3">
                                <MudAvatar Size="Size.Medium" Elevation="2">
                                    @if (!string.IsNullOrEmpty(msg.AvatarUrl))
                                    {
                                        <MudImage Src="@msg.AvatarUrl" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@(msg.IsUser ? Icons.Material.Filled.Person : Icons.Material.Filled.SmartToy)" />
                                    }
                                </MudAvatar>
                                <div style="max-width: 75%; display: flex; flex-direction: column; align-items: @(msg.IsUser ? "flex-end" : "flex-start");">
                                    <span class="chat-sender-name">@(msg.IsUser ? "You" : "David")</span>
                                    <MudPaper Class="pa-4 message-fade-in" Elevation="1"
                                              Style="@(msg.IsUser ? "background-color: var(--mud-palette-primary); color: white; border-radius: 15px 15px 0 15px;" : "background-color: #32333d; color: white; border-radius: 15px 15px 15px 0; border: 1px solid rgba(255,255,255,0.1);")">
                                        @if (!msg.IsUser && !msg.IsComplete && string.IsNullOrWhiteSpace(msg.Text))
                                        {
                                            <div style="display: flex; gap: 4px; align-items: center; justify-content: center; height: 24px; width: 40px;">
                                                <div style="width: 6px; height: 6px; background-color: #FFFFFF !important; border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both;"></div>
                                                <div style="width: 6px; height: 6px; background-color: #FFFFFF !important; border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both; animation-delay: 0.2s;"></div>
                                                <div style="width: 6px; height: 6px; background-color: #FFFFFF !important; border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both; animation-delay: 0.4s;"></div>
                                            </div>
                                        }
                                        else if (!msg.IsUser)
                                        {
                                            <div style="color: #F8FAFC; line-height: 1.6; font-size: 1.02em; white-space: pre-wrap; word-break: break-word;">
                                                @msg.FormattedText

                                                @* HARDWARE HANDSHAKE VISUAL GAP FILLER *@
                                                @if (_isWaitingForAudioStreamHook && !_isAudioTypingStarted && !msg.IsComplete && _messages.LastOrDefault(m => !m.IsUser) == msg)
                                                {
                                                    <span class="ml-2" style="display: inline-flex; gap: 3px; align-items: center; vertical-align: middle;">
                                                        <span style="width: 5px; height: 5px; background-color: #FFFFFF !important; border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both;"></span>
                                                        <span style="width: 5px; height: 5px; background-color: #FFFFFF !important; border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both; animation-delay: 0.2s;"></span>
                                                        <span style="width: 5px; height: 5px; background-color: #FFFFFF !important; border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both; animation-delay: 0.4s;"></span>
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body1" Style="color: inherit; white-space: pre-wrap; font-size: 0.95rem; word-break: break-word;">
                                                @msg.Text
                                            </MudText>
                                        }
                                    </MudPaper>
                                </div>
                            </div>
                        }
                    }

                    @if (_isTyping && (_messages.LastOrDefault()?.IsUser == true || _messages.Count == 0))
                    {
                        <div style="display: flex; flex-direction: row;" class="bubble-entrance mb-6 gap-3">
                            <MudAvatar Size="Size.Medium" Elevation="2">
                                <MudImage Src="@_avatarUrl" />
                            </MudAvatar>
                            <div style="display: flex; flex-direction: column;">
                                <MudPaper Class="pa-4" Elevation="1" Style="background-color: #32333d; color: white; border-radius: 15px 15px 15px 0; border: 1px solid rgba(255,255,255,0.1);">
                                    <div class="typing-indicator" style="display: flex; gap: 4px; align-items: center; justify-content: center; height: 24px; width: 40px;">
                                        <div style="width: 6px; height: 6px; background-color: #FFFFFF !important; border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both;"></div>
                                        <div style="width: 6px; height: 6px; background-color: #FFFFFF !important; border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both; animation-delay: 0.2s;"></div>
                                        <div style="width: 6px; height: 6px; background-color: #FFFFFF !important; border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both; animation-delay: 0.4s;"></div>
                                    </div>
                                </MudPaper>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (HostEnvironment.IsDevelopment())
            {
                @if (_showAvatarPanel)
                {
                    <div style="width: 320px; background-color: #1e1e24; display: flex; flex-direction: column;" class="pa-4">
                        <AIAvatar @ref="_avatarComponent"
                                  OnWordSpoken="HandleStreamingWordReceived"
                                  OnAudioLive="HandlePhysicalAudioLive" />
                    </div>
                }
            }
            else
            {
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        @if (_showAvatarPanel)
                        {
                            <div style="width: 320px; background-color: #1e1e24; display: flex; flex-direction: column;" class="pa-4">
                                <AIAvatar @ref="_avatarComponent"
                                          OnWordSpoken="HandleStreamingWordReceived"
                                          OnAudioLive="HandlePhysicalAudioLive" />
                            </div>
                        }
                    </Authorized>
                </AuthorizeView>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="px-4 pb-2" style="width: 100%;">
            <MudTextField @ref="_textField"
                          @bind-Value="_userInput"
                          OnKeyDown="HandleKeyDown"
                          Placeholder="Ask about my experience, skills, or projects..."
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Send"
                          AdornmentColor="@(_disableInput ? Color.Default : Color.Primary)"
                          OnAdornmentClick="SendMessage"
                          Immediate="true"
                          Disabled="_disableInput" />
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Class { get; set; } = "chat-dark";
    private MudTextField<string> _textField = default!;
    private string _customStyle => State.HasPosition
        ? $"position: fixed; margin: 0; top: {State.Top}; left: {State.Left}; width: {(_showAvatarPanel ? "770px" : (string.IsNullOrEmpty(State.Width) ? "450px" : State.Width))}; height: {State.Height}; max-width: none; z-index: 3500 !important;"
        : "z-index: 3500 !important;";

    private List<ChatMessage> _messages = new();
    private string _userInput = "";
    private bool _isTyping = false;
    private bool _disableInput = true;
    private const string _avatarUrl = "images/my-profile-pic.jpg";
    private const string _userAvatarUrl = "images/user-profile-pic.png";
    private AIAvatar? _avatarComponent;
    private bool _showAvatarPanel = false;
    private bool ShowAvatarPanel
    {
        get => _showAvatarPanel;
        set
        {
            if (_showAvatarPanel != value)
            {
                _showAvatarPanel = value;
                if (value == true)
                {
                    // Toggle hotswap mode tracking
                    _isWaitingForAudioStreamHook = true;
                    _isAudioTypingStarted = false;
                }
                if (value == false)
                {
                    System.Diagnostics.Debug.WriteLine("[BLAZOR-SAFETY] Panel hidden.");
                    _disableInput = false;
                    _isTyping = false;
                    _isWaitingForAudioStreamHook = false;
                    var activeAiMessage = _messages.LastOrDefault(m => !m.IsUser);
                    if (activeAiMessage is not null) activeAiMessage.IsComplete = true;
                }
                InvokeAsync(StateHasChanged);
            }
        }
    }

    private bool _isExiting = false;
    private DotNetObjectReference<ChatDialog>? _chatDialogRef;

    // A simple guard token to ensure our greeting animation sequence logic only fires once
    private bool _hasGreetingRendered = false;
    string hiddenTextPayloadTracker = "";
    private bool isDeceleratingHotSwap = false;

    private bool _isWaitingForAudioStreamHook = false;
    private bool _isAudioTypingStarted = false;

    protected override Task OnInitializedAsync()
    {
        // LEAVE EMPTY: We move the greeting out of here to stop server-side pre-render duplication bugs!
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _chatDialogRef = DotNetObjectReference.Create(this);
            await Task.Delay(150);
            await JSRuntime.InvokeVoidAsync("initChatDrag", _chatDialogRef);

            if (!_hasGreetingRendered && !_messages.Any())
            {
                // ==============================================================================
                // INITIALIZATION UI GATE LOCK
                // Force an immediate re-render on step one to lock the text entry controls
                // BEFORE any heavy background Task.Delays block the execution thread!
                // ==============================================================================
                _hasGreetingRendered = true;
                _disableInput = true;
                _isExiting = false;

                await InvokeAsync(StateHasChanged); // Snaps the input box disabled instantly!
                // ==============================================================================

                var connectionBar = new ChatMessage { IsConnecting = true };
                _messages.Add(connectionBar);
                await InvokeAsync(StateHasChanged);

                await Task.Delay(4500);

                _isExiting = true;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(400);

                _messages.Remove(connectionBar);
                _isExiting = false;
                _isTyping = true;
                await InvokeAsync(StateHasChanged);

                await Task.Delay(2500);

                var greetingMsg = new ChatMessage
                {
                    Text = "",
                    IsUser = false,
                    UserName = "David",
                    AvatarUrl = _avatarUrl,
                    IsComplete = false
                };
                _messages.Add(greetingMsg);

                string fullGreetingText = "How are you today?";

                if (ShowAvatarPanel && _avatarComponent is not null)
                {
                    _isTyping = false;     // Clear bouncing loading dots instantly
                    _disableInput = true;  // Keep user input field securely locked while greeting loads
                    await InvokeAsync(StateHasChanged);

                    // Initialize the parallel web audio background stream structures safely
                    await _avatarComponent.StartStreamingSession();
                    await _avatarComponent.AppendStreamingToken(fullGreetingText);
                    await _avatarComponent.FinalizeStreamingSession();

                    // HARD TIMEOUT BYPASS RESILIENCY VALVE:
                    // This acts strictly as an un-awaited background supervisor guard.
                    // It will ONLY step in to unlock if a catastrophic initialization failure occurs!
                    _ = Task.Run(async () =>
                    {
                        await Task.Delay(4000); // Extended to 4 seconds to cover backend cold-start generation

                        await InvokeAsync(async () =>
                                                {
                                                    // If the system is still accidentally locked due to a network glitch, clear it safely
                                                    if (_disableInput && _messages.Count == 1 && _messages.LastOrDefault()?.IsUser == false)
                                                    {
                                                        System.Diagnostics.Debug.WriteLine("[BLAZOR-SAFETY] Hydration timeout hit. Enforcing fallback release.");
                                                        _disableInput = false;
                                                        _isTyping = false;

                                                        var currentActiveAiMsg = _messages.LastOrDefault(m => !m.IsUser);
                                                        if (currentActiveAiMsg is not null) currentActiveAiMsg.IsComplete = true;

                                                        StateHasChanged();

                                                        if (_textField is not null)
                                                        {
                                                            await _textField.FocusAsync();
                                                        }
                                                    }
                                                });
                    });
                }
                else
                {
                    // ==============================================================================
                    // FALLBACK ISOLATION VALVE: Only runs if the avatar face panel is completely closed!
                    // This is the ONLY place where C# can immediately reset state variables.
                    // ==============================================================================
                    string[] chunks = new string[] { "How ", "are you ", "today?" };
                    bool firstWord = true;

                    foreach (var chunk in chunks)
                    {
                        if (firstWord)
                        {
                            _isTyping = false;
                            firstWord = false;
                        }
                        greetingMsg.Text += chunk;
                        greetingMsg.FormattedText = (await ChatbotService.FormatMessage(greetingMsg.Text)).Text;
                        await InvokeAsync(StateHasChanged);
                        await Task.Delay(new Random().Next(160, 280));
                    }

                    greetingMsg.IsComplete = true;
                    _disableInput = false; // Safely unlocks here ONLY if face panel is hidden
                    _isTyping = false;
                    await InvokeAsync(StateHasChanged);
                    if (_textField is not null) await _textField.FocusAsync();
                }
                // ==============================================================================
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_disableInput && !string.IsNullOrWhiteSpace(_userInput))
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_userInput) || _isTyping || _disableInput) return;

        var userText = _userInput;
        _messages.Add(new ChatMessage { Text = userText, IsUser = true, UserName = "You", AvatarUrl = _userAvatarUrl, IsComplete = true });

        _userInput = "";
        await ScrollToBottom();
        _isTyping = true;
        _disableInput = true;
        await InvokeAsync(StateHasChanged);
        await ScrollToBottom();

        var aiMsg = new ChatMessage { Text = "", IsUser = false, UserName = "David", AvatarUrl = _avatarUrl, IsComplete = false };        
        bool isAudioSessionInitialized = false;
        int hotSwapTypingDelay = 0;

        var chatRequest = new ChatRequest
        {
            Question = userText,
            History = _messages.Take(_messages.Count - 1).TakeLast(10).Select(m => new ChatMessageRequest
            {
                AvatarUrl = m.AvatarUrl,
                IsComplete = m.IsComplete,
                IsConnecting = m.IsComplete,
                IsUser = m.IsUser,
                Text = m.Text,
                Timestamp = m.Timestamp,
                UserName = m.UserName
            }).ToList()
        };

        var request = new HttpRequestMessage(HttpMethod.Post, $"{NavigationManager.BaseUri}api/chat")
        {
            Content = JsonContent.Create(chatRequest)
        };

        request.SetBrowserResponseStreamingEnabled(true);
        request.Headers.Accept.Add(new System.Net.Http.Headers.MediaTypeWithQualityHeaderValue("text/event-stream"));

        try
        {
            var response = await Http.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
            response.EnsureSuccessStatusCode();

            using var stream = await response.Content.ReadAsStreamAsync();
            using var reader = new StreamReader(stream);

            string? line;
            bool firstWordReceived = false;

            while ((line = await reader.ReadLineAsync()) != null)
            {
                if (line.StartsWith("data: "))
                {
                    var chunk = line["data: ".Length..];

                    if (!firstWordReceived)
                    {
                        _isTyping = false;
                        _messages.Add(aiMsg);
                        firstWordReceived = true;

                        if (_showAvatarPanel && _avatarComponent is not null)
                        {
                            await _avatarComponent.StartStreamingSession();
                            isAudioSessionInitialized = true;
                        }
                    }

                    string sanitizedChunk = string.IsNullOrEmpty(chunk)
                        ? "\n"
                        : chunk.Replace("\\n", "\n").Replace("\r", "");

                    hiddenTextPayloadTracker += sanitizedChunk;

                    // ==============================================================================
                    // 1. DUAL-STREAMING ORCHESTRATOR GATING VALVE
                    // ==============================================================================
                    if (_showAvatarPanel && _avatarComponent is not null && !string.IsNullOrWhiteSpace(sanitizedChunk))
                    {
                        if (!isAudioSessionInitialized)
                        {
                            try
                            {
                                string pythonVoiceUrl = Configuration["VoiceEngineUrl"] ?? "http://localhost:5000/api/tts";
                                await JSRuntime.InvokeVoidAsync("initializeVoiceStreamSession", pythonVoiceUrl);
                                isAudioSessionInitialized = true;

                                // Trigger the UI layer to slow down its typing pace
                                isDeceleratingHotSwap = true;
                            }
                            catch { /* Safety fallback */ }
                        }

                        string healedChunk = System.Text.RegularExpressions.Regex.Replace(sanitizedChunk, @"([A-Za-z])([0-9])", "$1 $2");

                        // PASS TO JAVASCRIPT INSTANTLY (Never delayed, keeping the audio pipeline fed!)
                        await JSRuntime.InvokeVoidAsync("accumulateAndStreamVoiceTokens", healedChunk);
                    }

                    if (!_showAvatarPanel)
                    {
                        // Standard mode: Render high-speed network text natively to screen layout
                        aiMsg.Text = hiddenTextPayloadTracker;

                        var formattedResult = await ChatbotService.FormatMessage(aiMsg.Text, false);
                        aiMsg.FormattedText = formattedResult.Text;
                        await InvokeAsync(StateHasChanged);
                        await ScrollToBottom();
                    }
                    else if (_showAvatarPanel && _isWaitingForAudioStreamHook)
                    {
                        // HOTSWAP TRANSITION LOCK:
                        // The user opened the panel. We freeze text rendering to let the audio engine sync.
                        // Instead of spamming StateHasChanged hundreds of times per second, we yield
                        // the execution thread gracefully so the browser can keep the dots smoothly animating!
                        await Task.Delay(45);
                    }

                    await Task.Yield();
                }
            }
        }
        catch (Exception ex)
        {
            aiMsg.Text = "An error occurred while getting a response.";
            System.Diagnostics.Debug.WriteLine(ex.Message);
        }
        finally
        {
            aiMsg.IsComplete = true;
            isDeceleratingHotSwap = false;
            _isWaitingForAudioStreamHook = false;
            _isAudioTypingStarted = false;

            // Use our local tracking flag to safely verify if an audio session was actually used
            if (isAudioSessionInitialized && _avatarComponent is not null)
            {
                await _avatarComponent.FinalizeStreamingSession();
            }
            else
            {
                aiMsg.Text = hiddenTextPayloadTracker;
                var formattedResult = await ChatbotService.FormatMessage(aiMsg.Text, aiMsg.IsComplete);
                aiMsg.FormattedText = formattedResult.Text;

                _isTyping = false;
                _disableInput = false;
                await InvokeAsync(StateHasChanged);
                await ScrollToBottom();
            }
        }
    }

    private async Task HandleStreamingWordReceived(string nextWord)
    {
        if (!_showAvatarPanel || string.IsNullOrWhiteSpace(nextWord))
            return;

        var activeAiMessage = _messages.LastOrDefault(m => !m.IsUser && !m.IsComplete);
        if (activeAiMessage is null) activeAiMessage = _messages.LastOrDefault(m => !m.IsUser);

        if (activeAiMessage is not null)
        {
            // Turn off the deceleration lock as soon as the voice audio pipeline catches up to the streaming head
            if (isDeceleratingHotSwap && !string.IsNullOrEmpty(hiddenTextPayloadTracker) &&
                activeAiMessage.Text.Length >= hiddenTextPayloadTracker.Length)
            {
                isDeceleratingHotSwap = false;
            }

            // ==============================================================================
            // AUDIO-DRIVEN TYPEWRITER REASSEMBLY ENGINE
            // ==============================================================================
            if (string.IsNullOrEmpty(activeAiMessage.Text))
            {
                activeAiMessage.Text = nextWord;
            }
            else
            {
                string cleanCurrent = System.Text.RegularExpressions.Regex.Replace(activeAiMessage.Text, @"[\[\]\(\)*_]", "");
                string cleanNext = System.Text.RegularExpressions.Regex.Replace(nextWord, @"[\[\]\(\)*_]", "");

                if (cleanCurrent.Length > 0 && cleanNext.Length > 0 && char.IsLetter(cleanCurrent[^1]) && char.IsDigit(cleanNext[0]))
                {
                    activeAiMessage.Text = activeAiMessage.Text.TrimEnd() + " " + nextWord.TrimStart();
                }
                else if (activeAiMessage.Text.TrimEnd().EndsWith(".") && cleanNext.Contains("NET", StringComparison.OrdinalIgnoreCase))
                {
                    activeAiMessage.Text = activeAiMessage.Text.TrimEnd() + nextWord.TrimStart();
                }
                else if (activeAiMessage.Text.EndsWith(" ") || nextWord.StartsWith(" ") || nextWord.StartsWith(",") || nextWord.StartsWith("."))
                {
                    activeAiMessage.Text += nextWord;
                }
                else
                {
                    activeAiMessage.Text += " " + nextWord;
                }
            }

            var formattedResult = await ChatbotService.FormatMessage(
                activeAiMessage.Text,
                activeAiMessage.IsComplete,
                specificKeyword: null,
                applyEnhancedKeywordStyling: false
            );

            activeAiMessage.FormattedText = formattedResult.Text;

            if (!_isAudioTypingStarted)
            {
                _isAudioTypingStarted = true;
                _isWaitingForAudioStreamHook = false; // Safety fallback clearance
            }

            await InvokeAsync(StateHasChanged);
            await InvokeAsync(ScrollToBottom);

            // ==============================================================================
            // VISUAL DECELERATION BRIDGE
            // If hot-swapped open late, add a progressive visual padding delay to the screen text
            // to smoothly blend the transition while the sound card fills its hardware queues
            // ==============================================================================
            if (isDeceleratingHotSwap)
            {
                // Applies a safe, non-blocking visual pacing break strictly to the screen layout update
                await Task.Delay(45);
            }
        }
    }

    [JSInvokable]
    public async Task OnSpeechFinished()
    {
        System.Diagnostics.Debug.WriteLine("[BLAZOR-DIALOG] Audio pipelines empty. Unlocking inputs.");

        // 1. Release UI input controls cleanly
        _isTyping = false;
        _disableInput = false;

        // 2. Mark the greeting or chat response bubble complete so formatting engines finalize
        var activeAiMessage = _messages.LastOrDefault(m => !m.IsUser);
        if (activeAiMessage is not null) activeAiMessage.IsComplete = true;

        await InvokeAsync(StateHasChanged);
        await InvokeAsync(ScrollToBottom);

        // 3. Force focus back to your text entry bar automatically
        if (_textField is not null)
        {
            await _textField.FocusAsync();
        }
    }

    [JSInvokable]
    public async Task OnPhysicalAudioStarted()
    {
        System.Diagnostics.Debug.WriteLine("[BLAZOR-HARDWARE] Audio waves are physically playing now. Releasing Blazor bubbles.");

        // 1. Drop the bubbles ONLY at this exact millisecond
        _isWaitingForAudioStreamHook = false;

        // 2. Synchronize our display text state to match the complete background buffer context
        var activeMsg = _messages.LastOrDefault(m => !m.IsUser);
        if (activeMsg is not null)
        {
            activeMsg.Text = hiddenTextPayloadTracker;
            var catchUpResult = await ChatbotService.FormatMessage(activeMsg.Text, false);
            activeMsg.FormattedText = catchUpResult.Text;
        }

        await InvokeAsync(StateHasChanged);
        await ScrollToBottom();
    }

    [JSInvokable]
    public void SaveDimensions(string top, string left, string width, string height)
    {
        State.Top = top; State.Left = left; State.Width = width; State.Height = height;
    }

    private async Task ScrollToBottom()
    {
        await Task.Delay(100);
        await JSRuntime.InvokeVoidAsync("scrollToBottom", "chat-container");
    }

    public async Task TriggerPhysicalAudioHandoff()
    {
        // 1. Drop the bubbles at this exact millisecond
        _isWaitingForAudioStreamHook = false;

        // 2. Catch up our text display layout to match background thread collections
        var activeMsg = _messages.LastOrDefault(m => !m.IsUser);
        if (activeMsg is not null)
        {
            activeMsg.Text = hiddenTextPayloadTracker;
            var catchUpResult = await ChatbotService.FormatMessage(activeMsg.Text, false);
            activeMsg.FormattedText = catchUpResult.Text;
        }

        await InvokeAsync(StateHasChanged);
        await ScrollToBottom();
    }

    private async Task HandlePhysicalAudioLive()
    {
        System.Diagnostics.Debug.WriteLine("[BLAZOR-HARDWARE] Audio waves are physically playing now. Shifting layout tracks.");

        // 1. Drop the bubbles at this exact millisecond
        _isWaitingForAudioStreamHook = false;

        // 2. Catch up our text container layout to match the background thread allocations
        var activeMsg = _messages.LastOrDefault(m => !m.IsUser);
        if (activeMsg is not null)
        {
            activeMsg.Text = hiddenTextPayloadTracker;
            var catchUpResult = await ChatbotService.FormatMessage(activeMsg.Text, false);
            activeMsg.FormattedText = catchUpResult.Text;
        }

        await InvokeAsync(StateHasChanged);
        await ScrollToBottom();
    }

    public void Dispose()
    {
        _chatDialogRef?.Dispose();

        // ==============================================================================
        // THE MASTER DIALOG SHUTDOWN VALVE
        // Triggers an immediate hardware mute pass the exact millisecond the user
        // closes or navigates away from the active ChatDialog panel!
        // ==============================================================================
        try
        {
            // Fire-and-forget call down to the browser sound card layer
            _ = JSRuntime.InvokeVoidAsync("forceStopAndResetAudioContext");
        }
        catch { /* Safe catch block in case window is already tearing down */ }
    }
}