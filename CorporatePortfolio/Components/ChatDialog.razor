@using CorporatePortfolio.DTO
@using CorporatePortfolio.Services
@using CorporatePortfolio.Services.DTO
@using Microsoft.AspNetCore.Components.WebAssembly.Http
@inject NavigationManager NavigationManager
@inject ChatState State
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@inject IHostEnvironment HostEnvironment
@inject HttpClient Http
@inject ChatbotService ChatbotService
@implements IDisposable

<MudDialog Class="chat-dark" Style="@_customStyle" ContentClass="mudDialog">
    <TitleContent>
        <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.SmartToy" Class="mr-3 mb-n1" />
                David Turner
            </MudText>

            <div @onclick:stopPropagation="true">
                @if (HostEnvironment.IsDevelopment())
                {
                    <MudToggleIconButton @bind-Toggled="ShowAvatarPanel"
                                         id="f5-avatar-toggle-btn"
                                         Icon="@Icons.Material.Filled.VideocamOff"
                                         Color="@Color.Default"
                                         ToggledIcon="@Icons.Material.Filled.Videocam"
                                         ToggledColor="@Color.Primary"
                                         ToolTip="@(ShowAvatarPanel ? "Hide AI Face Stream" : "Show AI Face Stream")"
                                         Class="mr-8" />
                }
                else
                {
                    <CascadingAuthenticationState>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <MudToggleIconButton @bind-Toggled="ShowAvatarPanel"
                                                     id="f5-avatar-toggle-btn"
                                                     Icon="@Icons.Material.Filled.VideocamOff"
                                                     Color="@Color.Default"
                                                     ToggledIcon="@Icons.Material.Filled.Videocam"
                                                     ToggledColor="@Color.Primary"
                                                     ToolTip="@(ShowAvatarPanel ? "Hide AI Face Stream" : "Show AI Face Stream")"
                                                     Class="mr-8" />
                            </Authorized>
                        </AuthorizeView>
                    </CascadingAuthenticationState>
                }
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div style="display: flex; width: 100%; height: 100%; max-height: calc(100vh - 120px); overflow: hidden;">
            <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden; border-right: 1px solid rgba(255,255,255,0.05);">
                <div id="chat-container" style="flex-grow: 1; overflow-y: auto;" class="pa-4">
                    @foreach (var msg in _messages)
                    {
                        @if (msg.IsConnecting)
                        {
                            <div class="connecting-status-bar @(_isExiting ? "fade-out-down" : "fade-in-down")">
                                <div class="connecting-dot-glow"></div>
                                <span class="connecting-text">Connecting with David Turner...</span>
                                <div class="scanner-sweep"></div>
                            </div>
                        }
                        else
                        {
                            <div style="display: flex; flex-direction: @(msg.IsUser ? "row-reverse" : "row");" class="mb-6 gap-3">
                                <MudAvatar Size="Size.Medium" Elevation="2">
                                    @if (!string.IsNullOrEmpty(msg.AvatarUrl))
                                    {
                                        <MudImage Src="@msg.AvatarUrl" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@(msg.IsUser ? Icons.Material.Filled.Person : Icons.Material.Filled.SmartToy)" />
                                    }
                                </MudAvatar>
                                <div style="max-width: 75%; display: flex; flex-direction: column; align-items: @(msg.IsUser ? "flex-end" : "flex-start");">
                                    <span class="chat-sender-name">@(msg.IsUser ? "You" : "David")</span>
                                    <MudPaper Class="pa-4 message-fade-in" Elevation="1"
                                              Style="@(msg.IsUser ? "background-color: var(--mud-palette-primary); color: white; border-radius: 15px 15px 0 15px;" : "background-color: #32333d; color: white; border-radius: 15px 15px 15px 0; border: 1px solid rgba(255,255,255,0.1);")">
                                        @if (!msg.IsUser && string.IsNullOrWhiteSpace(msg.Text))
                                        {
                                            <div style="display: flex; gap: 4px; align-items: center; justify-content: center; height: 24px; width: 40px;">
                                                <div style="width: 6px; height: 6px; background-color: #FFFFFF !important; border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both;"></div>
                                                <div style="width: 6px; height: 6px; background-color: #FFFFFF !important; border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both; animation-delay: 0.2s;"></div>
                                                <div style="width: 6px; height: 6px; background-color: #FFFFFF !important; border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both; animation-delay: 0.4s;"></div>
                                            </div>
                                        }
                                        else if (!msg.IsUser)
                                        {
                                            <div style="color: #F8FAFC; line-height: 1.6; font-size: 1.02em; white-space: pre-wrap; word-break: break-word;">
                                                @msg.FormattedText
                                            </div>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body1" Style="color: inherit; white-space: pre-wrap; font-size: 0.95rem; word-break: break-word;">
                                                @msg.Text
                                            </MudText>
                                        }
                                    </MudPaper>
                                </div>
                            </div>
                        }
                    }

                    @if (_isTyping && (_messages.LastOrDefault()?.IsUser == true || _messages.Count == 0))
                    {
                        <div style="display: flex; flex-direction: row;" class="bubble-entrance mb-6 gap-3">
                            <MudAvatar Size="Size.Medium" Elevation="2">
                                <MudImage Src="@_avatarUrl" />
                            </MudAvatar>
                            <div style="display: flex; flex-direction: column;">
                                <MudPaper Class="pa-4" Elevation="1" Style="background-color: #32333d; color: white; border-radius: 15px 15px 15px 0; border: 1px solid rgba(255,255,255,0.1);">
                                    <div class="typing-indicator" style="display: flex; gap: 4px; align-items: center; justify-content: center; height: 24px; width: 40px;">
                                        <div style="width: 6px; height: 6px; background-color: #FFFFFF !important; border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both;"></div>
                                        <div style="width: 6px; height: 6px; background-color: #FFFFFF !important; border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both; animation-delay: 0.2s;"></div>
                                        <div style="width: 6px; height: 6px; background-color: #FFFFFF !important; border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both; animation-delay: 0.4s;"></div>
                                    </div>
                                </MudPaper>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (HostEnvironment.IsDevelopment())
            {
                <div style="@(_showAvatarPanel ? "display: block;" : "display: none;")">
                    <AIAvatar @ref="_avatarComponent"
                              OnWordSpoken="HandleStreamingWordReceived"
                              OnAudioLive="HandlePhysicalAudioLive"
                              OnSpeechFinishedCallback="OnSpeechFinished"
                              IsParentUiLocked="@(_isTyping || _isAudioTypingStarted || _isWaitingForAudioStreamHook || _disableInput)" />
                </div>
            }   
            else
            {
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <div style="@(_showAvatarPanel ? "display: block;" : "display: none;")">
                            <AIAvatar @ref="_avatarComponent"
                                      OnWordSpoken="HandleStreamingWordReceived"
                                      OnAudioLive="HandlePhysicalAudioLive"
                                      OnSpeechFinishedCallback="OnSpeechFinished"
                                      IsParentUiLocked="@(_isTyping || _isAudioTypingStarted || _isWaitingForAudioStreamHook || _disableInput)" />
                        </div>
                    </Authorized>
                </AuthorizeView>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="px-4 pb-2" style="width: 100%;">
            <MudTextField @ref="_textField"
                          @bind-Value="_userInput"
                          OnKeyDown="HandleKeyDown"
                          Placeholder="Ask about my experience, skills, or projects..."
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Send"
                          AdornmentColor="@(_disableInput ? Color.Default : Color.Primary)"
                          OnAdornmentClick="SendMessage"
                          Immediate="true"
                          Disabled="_disableInput" />
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Class { get; set; } = "chat-dark";
    private MudTextField<string> _textField = default!;
    private string _customStyle => State.HasPosition
        ? $"position: fixed; margin: 0; top: {State.Top}; left: {State.Left}; width: {(_showAvatarPanel ? "770px" : (string.IsNullOrEmpty(State.Width) ? "450px" : State.Width))}; height: {State.Height}; max-width: none; z-index: 3500 !important;"
        : "z-index: 3500 !important;";

    private List<ChatMessage> _messages = new();
    private string _userInput = "";
    private bool _isTyping = false;
    private bool _disableInput = true;
    private const string _avatarUrl = "images/my-profile-pic.jpg";
    private const string _userAvatarUrl = "images/user-profile-pic.png";
    private AIAvatar _avatarComponent;
    private bool _showAvatarPanel = false;
    private bool ShowAvatarPanel
    {
        get => _showAvatarPanel;
        set
        {
            if (_showAvatarPanel != value)
            {
                _showAvatarPanel = value;
                if (value == true)
                {
                    _isWaitingForAudioStreamHook = true;
                    _isAudioTypingStarted = false;

                    _ = InvokeAsync(StateHasChanged);
                }
                if (value == false)
                {
                    System.Diagnostics.Debug.WriteLine("[BLAZOR-SAFETY] Closing avatar panel and resetting audio states.");

                    if (_avatarComponent is not null)
                    {
                        _ = _avatarComponent.ForceStopAndResetAudioContext();
                    }

                    _isWaitingForAudioStreamHook = false;
                    _isAudioTypingStarted = false;
                    _isAudioSessionInitialized = false;

                    _ = UpdateState();
                }
            }
        }
    }

    private bool _isExiting = false;
    private DotNetObjectReference<ChatDialog>? _chatDialogRef;
    private DotNetObjectReference<AIAvatar>? _persistentAvatarRef;

    private bool _isGeneratingSummary = false;
    private bool _isMutedForSummary = false;
    private bool _hasTriggeredSummaryRequest = false;
    private bool _hasGreetingRendered = false;
    private bool _isWaitingForAudioStreamHook = false;
    private bool _isAudioTypingStarted = false;
    private bool _isAudioSessionInitialized = false;
    private bool _summaryPipelineActive = false;
    private PeriodicTimer? _healthCheckTimer;
    private readonly CancellationTokenSource _healthCheckCts = new();
    private bool _isF5ServerConnected = false;

    protected override async Task OnInitializedAsync()
    {
        await VerifyServerHealth();
        await UpdateState();
        _ = StartBackgroundHealthCheckLoop();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _chatDialogRef = DotNetObjectReference.Create(this);
            await Task.Delay(150);
            await JSRuntime.InvokeVoidAsync("initChatDrag", _chatDialogRef);

            await Task.Delay(50);
            await ToggleAvatarButtonLock();

            if (!_hasGreetingRendered && !_messages.Any())
            {
                _disableInput = true;
                _isExiting = false;

                await UpdateState(); 

                var connectionBar = new ChatMessage { IsConnecting = true };
                _messages.Add(connectionBar);
                await UpdateState();

                await Task.Delay(4500);

                _isExiting = true;
                await UpdateState();
                await Task.Delay(400);

                _messages.Remove(connectionBar);
                _isExiting = false;
                _isTyping = true;
                await UpdateState();

                await Task.Delay(2500);

                var greetingMsg = new ChatMessage
                {
                    Text = "",
                    IsUser = false,
                    UserName = "David",
                    AvatarUrl = _avatarUrl,
                    IsComplete = false
                };
                _messages.Add(greetingMsg);

                string fullGreetingText = "How are you today?";

                if (ShowAvatarPanel && _avatarComponent is not null)
                {
                    // 1. Maintain thinking indicators and lock user input
                    _isTyping = true;
                    _disableInput = true;
                    _isWaitingForAudioStreamHook = true;
                    await UpdateState();

                    // 2. Keep the text blank so the empty bubble doesn't render prematurely
                    greetingMsg.Text = "";
                    greetingMsg.FormattedText = (await ChatbotService.FormatMessage("")).Text;
                    await UpdateState();

                    // 3. Queue the greeting text straight to your F5 engine
                    await _avatarComponent.StartStreamingSession();
                    await _avatarComponent.AppendStreamingToken(fullGreetingText);

                    // 4. Finalize the stream. The textbox will now stay locked until David finishes speaking!
                    await _avatarComponent.FinalizeStreamingSession();
                }
                else
                {
                    string[] chunks = new string[] { "How ", "are you ", "today?" };
                    bool firstWord = true;

                    foreach (var chunk in chunks)
                    {
                        if (firstWord)
                        {
                            _isTyping = false;
                            firstWord = false;
                        }
                        greetingMsg.Text += chunk;
                        greetingMsg.FormattedText = (await ChatbotService.FormatMessage(greetingMsg.Text)).Text;
                        await UpdateState();
                        await Task.Delay(new Random().Next(160, 280));
                    }

                    greetingMsg.IsComplete = true;
                    _disableInput = false; // Safely unlocks here ONLY if face panel is hidden
                    _isTyping = false;
                    _hasGreetingRendered = true;
                    await UpdateState();
                    if (_textField is not null) await _textField.FocusAsync();
                }
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_disableInput && !string.IsNullOrWhiteSpace(_userInput))
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_userInput) || _isTyping || _disableInput) return;

        var userText = _userInput;
        _messages.Add(new ChatMessage { Text = userText, IsUser = true, UserName = "You", AvatarUrl = _userAvatarUrl, IsComplete = true });

        _userInput = "";
        await UpdateState();

        _isTyping = true;
        _disableInput = true;
        await UpdateState();

        var aiMsg = new ChatMessage { Text = " ", IsUser = false, UserName = "David", AvatarUrl = _avatarUrl, IsComplete = false };
        _messages.Add(aiMsg);
        await UpdateState();

        var chatRequest = new ChatRequest
        {
            Question = userText,
            History = _messages.Take(_messages.Count - 1).TakeLast(10).Select(m => new ChatMessageRequest
            {
                AvatarUrl = m.AvatarUrl,
                IsComplete = m.IsComplete,
                IsConnecting = m.IsComplete,
                IsUser = m.IsUser,
                Text = m.Text,
                Timestamp = m.Timestamp,
                UserName = m.UserName
            }).ToList()
        };

        var request = new HttpRequestMessage(HttpMethod.Post, $"{NavigationManager.BaseUri}api/chat")
        {
            Content = JsonContent.Create(chatRequest)
        };

        request.SetBrowserResponseStreamingEnabled(true);
        request.Headers.Accept.Add(new System.Net.Http.Headers.MediaTypeWithQualityHeaderValue("text/event-stream"));

        string serverTextAccumulator = "";

        try
        {
            var response = await Http.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
            response.EnsureSuccessStatusCode();

            using var stream = await response.Content.ReadAsStreamAsync();
            using var reader = new StreamReader(stream);

            string? line;
            bool firstWordReceived = false;

            while ((line = await reader.ReadLineAsync()) != null)
            {
                if (line.StartsWith("data: "))
                {
                    var chunk = line["data: ".Length..];
                    if (!firstWordReceived)
                    {
                        firstWordReceived = true;

                        if (_showAvatarPanel)
                        {
                            await _avatarComponent.StartStreamingSession();
                            _isAudioSessionInitialized = true;
                        }
                    }

                    string sanitizedChunk = string.IsNullOrEmpty(chunk) ? "\n" : chunk.Replace("\\n", "\n").Replace("\r", "");

                    serverTextAccumulator += sanitizedChunk;

                    // --- MARKDOWN TARGETED TOKEN INTERCEPTOR ---
                    if (_showAvatarPanel && !string.IsNullOrWhiteSpace(sanitizedChunk))
                    {
                        // 1. Initialize audio stream layout structures safely
                        if (!_isAudioSessionInitialized && _avatarComponent is not null)
                        {
                            try
                            {
                                await _avatarComponent.StartStreamingSession();
                                _isAudioSessionInitialized = true;
                            }
                            catch { }
                        }

                        // 2. SCAN FOR MARKDOWN LAYOUT SIGNATURES
                        if (sanitizedChunk.Contains("#") ||
                            sanitizedChunk.Contains(" -") ||
                            serverTextAccumulator.Contains("# Core Tech") ||
                            serverTextAccumulator.Contains("# Azure") ||
                            sanitizedChunk.Contains("<contact_data>") ||
                            serverTextAccumulator.Contains("<contact_data>") ||
                            serverTextAccumulator.Contains("## CONTACT"))
                        {
                            if (!_isMutedForSummary)
                            {
                                _isMutedForSummary = true;

                                // --- CRITICAL TIMER FIX ---
                                // Set the shield right here inside the live loop token check!
                                // This ensures that when FinalizeStreamingSession yields,
                                // OnSpeechFinished sees the true state and blocks the unlock!
                                _summaryPipelineActive = true;

                                if (_avatarComponent is not null)
                                {
                                    await _avatarComponent.FinalizeStreamingSession();
                                }
                            }
                        }

                        // 3. EXECUTE VOICE ENGINE ROUTING
                        if (!_isMutedForSummary)
                        {
                            string healedChunk = System.Text.RegularExpressions.Regex.Replace(sanitizedChunk, @"([A-Za-z])([0-9])", "$1 $2");
                            if (_avatarComponent is not null)
                            {
                                await _avatarComponent.AppendStreamingToken(healedChunk);
                            }
                        }
                    }

                    if (!_showAvatarPanel)
                    {
                        aiMsg.Text = serverTextAccumulator;
                        var formattedResult = await ChatbotService.FormatMessage(aiMsg.Text, false);
                        aiMsg.FormattedText = formattedResult.Text;
                        await UpdateState();
                    }
                    else
                    {
                        await Task.Yield();
                    }

                    await Task.Yield();
                }
            }
        }
        catch (Exception ex)
        {
            aiMsg.Text = "An error occurred while getting a response.";
            System.Diagnostics.Debug.WriteLine(ex.Message);

            await HandleServerFailure();
        }
        finally
        {
            aiMsg.IsComplete = true;

            if (_showAvatarPanel && _avatarComponent is not null)
            {
                if (_isMutedForSummary)
                {
                    // Re-affirm parameters before kicking off background thread processing
                    _summaryPipelineActive = true;

                    _isWaitingForAudioStreamHook = true;
                    _isTyping = true;
                    _disableInput = true;

                    _ = InvokeDelayedSummaryPipelineAsync(serverTextAccumulator);
                }
                else
                {
                    _summaryPipelineActive = false;
                    _isWaitingForAudioStreamHook = true;
                    _isTyping = true;
                    _disableInput = true;

                    await _avatarComponent.FinalizeStreamingSession();
                }
            }
            else
            {
                _summaryPipelineActive = false;
                _isAudioTypingStarted = false;
                _isTyping = false;
                _disableInput = false;
            }

            await UpdateState();
            if (_textField is not null) await _textField.FocusAsync();
        }
    }

    private async Task InvokeDelayedSummaryPipelineAsync(string completeFormattedText)
    {
        try
        {
            // 1. Maintain rigid UI input restrictions
            _summaryPipelineActive = true;
            _disableInput = true;
            _isTyping = true;
            _isWaitingForAudioStreamHook = true;
            await UpdateState();

            // 2. Fetch the clean verbal brief from Llama
            string generatedSummary = "";

            // --- DETECT CONTACT BLOCK IN ACCUMULATED TEXT ---
            if (completeFormattedText.Contains("<contact_data>") || completeFormattedText.Contains("dave.w.turner@outlook.com"))
            {
                // Overrides the robotic overview with your custom conversational line!
                generatedSummary = "If you'd like to get in touch with me, I've gone ahead and placed my direct contact details right inside our chat window.";
            }
            else
            {
                // Normal summary behavior for skills and projects
                generatedSummary = await ChatbotService.GenerateVerbalSummary(completeFormattedText);
            }

            if (_avatarComponent is not null && _showAvatarPanel)
            {
                // 3. Start the F5 streaming audio session for the summary text
                await _avatarComponent.StartStreamingSession(muteWordTracking: true);

                // 4. Split the verbal summary into sentences to stream to F5 immediately
                string[] summarySentences = System.Text.RegularExpressions.Regex.Split(generatedSummary, @"(?<=[.!?])\s+");
                foreach (var sentence in summarySentences)
                {
                    if (string.IsNullOrWhiteSpace(sentence)) continue;

                    string healedSentence = System.Text.RegularExpressions.Regex.Replace(
                        sentence, @"([A-Za-z])([0-9])", "$1 $2"
                    );

                    await _avatarComponent.AppendStreamingToken(healedSentence + " ");
                }

                _summaryPipelineActive = false;

                // 5. Finalize the audio stream session so it knows no more sentences are coming
                await _avatarComponent.FinalizeStreamingSession();

                // 6. ASYNC TYPEWRITER EFFECT FOR THE ORIGINAL SKILLS TEXT
                // Find the current assistant message object in your UI list
                var currentActiveAiMsg = _messages.LastOrDefault(m => !m.IsUser);
                if (currentActiveAiMsg is not null)
                {
                    // Clear the thinking indicators right as text starts typing out
                    _isTyping = false;
                    await UpdateState();

                    // Split the original complete markdown skills text by space boundaries
                    string[] textWords = completeFormattedText.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                    string textAccumulator = "";

                    foreach (var word in textWords)
                    {
                        textAccumulator += word + " ";

                        // Assign text to raw buffer to satisfy your row layout guard condition
                        currentActiveAiMsg.Text = textAccumulator;

                        // Pass to your formatting service to maintain all your custom style templates
                        var formattedResult = await ChatbotService.FormatMessage(
                            textAccumulator,
                            isComplete: false,
                            specificKeyword: null,
                            applyEnhancedKeywordStyling: false
                        );
                        currentActiveAiMsg.FormattedText = formattedResult.Text;

                        await UpdateState();

                        // Adjust this delay (in milliseconds) to speed up or slow down the typewriter speed
                        await Task.Delay(40);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[TYPEWRITER-SUMMARY-ERROR] Pipeline failed: {ex.Message}");
        }
        finally
        {
            // --- ONLY RESET STATE PARSING VARIABLES ---
            // Do NOT unlock inputs here. The physical hardware event OnSpeechFinished()
            // will safely re-enable the textbox once David finishes speaking!
            _isMutedForSummary = false;
            await UpdateState();
        }
    }

    private async Task HandleStreamingWordReceived(string nextWord)
    {
        if (!_showAvatarPanel || string.IsNullOrWhiteSpace(nextWord)) return;

        // --- ADD THIS SENTINEL INTERCEPT GATING CHECK ---
        if (nextWord == "[SANDBOX_START]")
        {
            _messages.Add(new ChatMessage
            {
                Text = "",
                IsUser = false,
                UserName = "David",
                AvatarUrl = _avatarUrl,
                IsComplete = false
            });

            await UpdateState();
            return;
        }

        // --- Your original layout logic remains completely untouched below here ---
        var activeAiMessage = _messages.LastOrDefault(m => !m.IsUser && !m.IsComplete)
                             ?? _messages.LastOrDefault(m => !m.IsUser);

        if (activeAiMessage is not null)
        {
            if (string.IsNullOrWhiteSpace(activeAiMessage.Text) || activeAiMessage.Text == " ")
            {
                activeAiMessage.Text = nextWord;
            }
            else if (!activeAiMessage.Text.EndsWith(nextWord))
            {
                activeAiMessage.Text += (activeAiMessage.Text.EndsWith(" ") ? "" : " ") + nextWord;
            }

            var formattedResult = await ChatbotService.FormatMessage(
                activeAiMessage.Text,
                activeAiMessage.IsComplete,
                specificKeyword: null,
                applyEnhancedKeywordStyling: false
            );
            activeAiMessage.FormattedText = formattedResult.Text;

            await UpdateState();
        }
    }

    private async Task ToggleAvatarButtonLock()
    {
        try
        {
            // Added logical OR check for server failure flag at the beginning
            if (!_isF5ServerConnected || _isTyping || _isAudioTypingStarted || _isWaitingForAudioStreamHook)
            {
                await JSRuntime.InvokeVoidAsync("eval", @"
                var btn = document.querySelector('#f5-avatar-toggle-btn');
                if (btn) {
                    btn.setAttribute('disabled', 'disabled');
                    btn.style.pointerEvents = 'none';
                    btn.style.opacity = '0.35';
                }
            ");
            }
            else
            {
                // Re-enable click actions and restore normal visibility
                await JSRuntime.InvokeVoidAsync("eval", @"
                var btn = document.querySelector('#f5-avatar-toggle-btn');
                if (btn) {
                    btn.removeAttribute('disabled');
                    btn.style.pointerEvents = 'auto';
                    btn.style.opacity = '1';
                }
            ");
            }
        }
        catch
        {
        }        
    }

    [JSInvokable]
    public async Task OnSpeechFinished()
    {
        System.Diagnostics.Debug.WriteLine("[BLAZOR-DIALOG] Audio track has completed physical playback. Safely unlocking textbox input.");

        if (_summaryPipelineActive)
        {
            System.Diagnostics.Debug.WriteLine("[AVATAR-GUARD] Intercepted premature release. Maintaining input lock.");
            return;
        }

        // 1. Release all UI restrictions here and only here
        _isTyping = false;
        _isAudioTypingStarted = false;
        _isWaitingForAudioStreamHook = false;
        _disableInput = false;

        // 2. Execute your standard message completion layout updates
        var activeAiMessage = _messages.LastOrDefault(m => !m.IsUser);
        if (activeAiMessage is not null)
        {
            activeAiMessage.IsComplete = true;
            var finalFormatResult = await ChatbotService.FormatMessage(
                activeAiMessage.Text,
                activeAiMessage.IsComplete,
                specificKeyword: null,
                applyEnhancedKeywordStyling: false
            );
            activeAiMessage.FormattedText = finalFormatResult.Text;
        }

        await UpdateState();

        if (_textField is not null)
        {
            await _textField.FocusAsync();
        }
    }

    [JSInvokable]
    public async Task OnPhysicalAudioStarted()
    {
        System.Diagnostics.Debug.WriteLine("[BLAZOR-HARDWARE] Audio waves are physically playing now. Releasing Blazor bubbles.");

        _isTyping = false;
        _isWaitingForAudioStreamHook = false;
        _isAudioTypingStarted = true;

        await UpdateState();
    }

    [JSInvokable]
    public void SaveDimensions(string top, string left, string width, string height)
    {
        State.Top = top; State.Left = left; State.Width = width; State.Height = height;
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(100);
            await JSRuntime.InvokeVoidAsync("scrollToBottom", "chat-container");
        }
        catch
        {
        }
    }

    private async Task HandlePhysicalAudioLive()
    {
        System.Diagnostics.Debug.WriteLine("[BLAZOR-HARDWARE] Audio waves are physically playing now. Shifting layout tracks.");

        _isWaitingForAudioStreamHook = false;
        _isAudioTypingStarted = true;

        await UpdateState();
    }

    private async Task UpdateState()
    {
        await ToggleAvatarButtonLock();
        await InvokeAsync(StateHasChanged);
        await ScrollToBottom();
    }

    private async Task HandleServerFailure()
    {
        _isF5ServerConnected = false;

        if (_showAvatarPanel)
        {
            System.Diagnostics.Debug.WriteLine("[BLAZOR-SAFETY] F5 Server offline event. Enforcing emergency stream closure.");

            if (_avatarComponent is not null)
            {
                try
                {
                    await _avatarComponent.ForceStopAndResetAudioContext();
                }
                catch { }
            }

            _showAvatarPanel = false;
            _isWaitingForAudioStreamHook = false;
            _isAudioTypingStarted = false;
            _isAudioSessionInitialized = false;
        }

        await UpdateState();
    }

    private async Task StartBackgroundHealthCheckLoop()
    {
        _healthCheckTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));

        try
        {
            while (await _healthCheckTimer.WaitForNextTickAsync(_healthCheckCts.Token))
            {
                try
                {
                    bool previouslyConnected = _isF5ServerConnected;

                    await VerifyServerHealth();

                    if (_isF5ServerConnected)
                    {
                        if (!previouslyConnected)
                        {
                            await InvokeAsync(async () =>
                            {
                                await UpdateState();
                                await ToggleAvatarButtonLock();
                            });
                        }
                    }
                    else
                    {
                        if (previouslyConnected)
                        {
                            await InvokeAsync(HandleServerFailure);
                        }
                    }
                }
                catch
                {
                    if (_isF5ServerConnected)
                    {
                        await InvokeAsync(HandleServerFailure);
                    }
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task VerifyServerHealth()
    {
        string healthCheckUrl = Configuration["VoiceEngineUrl"] != null ? $"{Configuration["VoiceEngineUrl"]}/docs" : null ?? $"http://localhost:5000/docs";

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));

            var response = await Http.GetAsync(healthCheckUrl, cts.Token);

            _isF5ServerConnected = response.IsSuccessStatusCode;
        }
        catch
        {
            _isF5ServerConnected = false;
        }
    }

    public void Dispose()
    {
        _healthCheckCts.Cancel();
        _healthCheckCts.Dispose();

        _healthCheckTimer?.Dispose();

        if (JSRuntime is not null)
        {
            try
            {
                _ = JSRuntime.InvokeVoidAsync("forceStopAndResetAudioContext");
            }
            catch { }
        }
        _chatDialogRef?.Dispose();
        _persistentAvatarRef?.Dispose();
    }
}