<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
    <EnableDefaultRazorGenerateItems>true</EnableDefaultRazorGenerateItems>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
    <UserSecretsId>f77a313f-16a9-49da-b072-eba9538352da</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Components\AIAvatar.razor.js" />
  </ItemGroup>

  <ItemGroup> 
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.12" /> 
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Hosting" Version="2.3.13" />
    <PackageReference Include="MudBlazor" Version="9.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CorporatePortfolio.Services\CorporatePortfolio.Services.csproj" />
  </ItemGroup>

</Project>